{
  "name": "muniback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Municipalidad de Buchardo",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "npm install --no-save --no-audit --no-fund typescript@5.6.3 && node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "build:front": "node scripts/copy-front.mjs",
    "build:full": "node scripts/copy-front.mjs && node scripts/clean.mjs dist && npm install --no-save --no-audit --no-fund typescript@5.6.3 && node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "lint": "node node_modules/eslint/bin/eslint.js src scripts tests",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "seed:admin": "node node_modules/tsx/dist/cli.mjs scripts/seed-admin.ts",
    "seed:pricing": "node node_modules/tsx/dist/cli.mjs scripts/seed-pricing.ts",
    "seed:demo": "node node_modules/tsx/dist/cli.mjs scripts/seed-demo.ts",
    "seed:real-users": "node node_modules/tsx/dist/cli.mjs scripts/seed-real-users.ts",
    "cleanup:testing": "node node_modules/tsx/dist/cli.mjs scripts/cleanup-testing.ts",
    "smoke:pricing": "node node_modules/tsx/dist/cli.mjs scripts/smoke-pricing.ts",
    "smoke:accounts": "node node_modules/tsx/dist/cli.mjs scripts/smoke-accounts.ts",
    "smoke:citizen": "node node_modules/tsx/dist/cli.mjs scripts/smoke-citizen.ts",
    "smoke:payments": "node node_modules/tsx/dist/cli.mjs scripts/smoke-payments.ts",
    "smoke:mvp": "node node_modules/tsx/dist/cli.mjs scripts/smoke-mvp.ts",
    "smoke:standalone": "node node_modules/tsx/dist/cli.mjs scripts/smoke-standalone.ts",
    "smoke:prod": "node node_modules/tsx/dist/cli.mjs scripts/smoke-prod-server.ts",
    "import:excel": "node node_modules/tsx/dist/cli.mjs scripts/import-excel.ts"
  },
  "dependencies": {
    "@types/multer": "^1.4.12",
    "@types/uuid": "^9.0.8",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "file-type": "^16.5.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^8.57.1",
    "mongodb-memory-server": "^10.1.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
