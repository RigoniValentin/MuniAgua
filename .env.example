# MuniBack — environment variables
# Copia este archivo como `.env` y completá los valores para tu entorno.
# Si una variable esencial falta o es inválida, el proceso falla al iniciar
# con un mensaje explícito.

# ==================================================
# SERVER
# ==================================================
NODE_ENV=development
PORT=3000

# ==================================================
# DATABASE
# ==================================================
MONGODB_URI=mongodb://127.0.0.1:27017/muniback

# Transaction strategy:
#   auto      — detect at startup, use transactions when supported,
#               otherwise use a compensated fallback (default).
#   enabled   — require transactions; the server refuses to start
#               against a MongoDB standalone (not a Replica Set).
#   disabled  — never use transactions, even when the server supports them.
# Local/demo installations may keep the default `auto`.
MONGO_TRANSACTION_MODE=auto

# ==================================================
# AUTH
# ==================================================
# Secretos JWT (mínimo 16 caracteres). Rotarlos antes de producción.
JWT_ACCESS_SECRET=replace_me_access_secret_32_chars
JWT_REFRESH_SECRET=replace_me_refresh_secret_32_chars
JWT_ACCESS_EXPIRES_IN=390m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=muni_rt

# ==================================================
# FRONTEND
# ==================================================
# Origen permitido para CORS en desarrollo (Vite en 5173).
# En producción, MuniBack sirve el build estático, pero CORS sigue vigente
# si el frontend está en un origen separado (por ejemplo, un CDN).
FRONTEND_URL=http://localhost:5173

# ==================================================
# PAYMENTS
# ==================================================
# Directorio donde se persisten los comprobantes encriptados por UUID.
# NO debe estar bajo `public/` (se regenera en cada build).
# La aplicación intenta crear el directorio al iniciar; falla con un
# mensaje claro si no hay permisos de escritura.
PAYMENT_RECEIPTS_DIR=./storage/payment-receipts

# Rate-limit del endpoint POST /api/payments/me.
# En tests se desactiva con `disabled`. En demo y producción, mantener el default.
PAYMENT_SUBMIT_RATE_LIMIT=enabled

# ==================================================
# DEMO
# ==================================================
# Credenciales sembradas por `npm run seed:demo`. Requeridas en producción
# (el seed aborta si alguna falta o si los placeholders no se reemplazaron).
# En desarrollo, se usan los siguientes defaults si la variable está vacía.
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=DemoAdmin123!
DEMO_DRIVER_EMAIL=repartidor@demo.local
DEMO_DRIVER_PASSWORD=DemoDriver123!
DEMO_CITIZEN_EMAIL=ciudadano@demo.local
DEMO_CITIZEN_PASSWORD=DemoCitizen123!

# ==================================================
# REAL USERS (producción)
# ==================================================
# Sembradas por `npm run seed:real-users`. Idempotente: si el email ya existe,
# se omite. Sobreescribí cualquier valor para personalizar.
TREASURY_ADMIN_EMAIL=tesoreriamunibuchardo@gmail.com
TREASURY_ADMIN_PASSWORD=Admin123!
TREASURY_ADMIN_PHONE=3385437074

ACCOUNTING_ADMIN_EMAIL=secretariacontablebuchardo@gmail.com
ACCOUNTING_ADMIN_PASSWORD=Admin123!
ACCOUNTING_ADMIN_PHONE=2302391342

DRIVER_EZEQUIEL_EMAIL=repartos_ezequiel@gmail.com
DRIVER_EZEQUIEL_PASSWORD=Reparto123!
DRIVER_EZEQUIEL_PHONE=3385461601

DRIVER_ROBERTINO_EMAIL=repartos_robertino@gmail.com
DRIVER_ROBERTINO_PASSWORD=Reparto123!
DRIVER_ROBERTINO_PHONE=2302391342

# (Legado) Variables SEED_ADMIN_* mantenidas para compatibilidad con el
# script `npm run seed:admin`. El operador puede usarlas para crear un
# SUPER_ADMIN propio.
SEED_ADMIN_EMAIL=admin@buchardo.gob.ar
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRSTNAME=Super
SEED_ADMIN_LASTNAME=Admin

# ==================================================
# PASSWORD RECOVERY (SMTP)
# ==================================================
# Sistema de recuperación de contraseña por email (self-service).
#
# - SMTP_ENABLED=false (default): el backend loguea el enlace de reset
#   por consola. Útil para desarrollo y para que la demo funcione sin
#   servidor de correo externo.
# - SMTP_ENABLED=true: requiere SMTP_HOST/PORT/USER/PASSWORD. El mailer
#   envía el email real al usuario.
#
# Importante en producción:
#   - PASSWORD_RESET_URL_BASE debe apuntar al origen público HTTPS del
#     frontend (ej. https://app.buchardo.gob.ar). El enlace viajará por
#     email con el token plano.
SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=Municipalidad de Buchardo <no-reply@buchardo.gob.ar>
PASSWORD_RESET_URL_BASE=http://localhost:5173
PASSWORD_RESET_TTL_MS=3600000
